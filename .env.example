# Copy to .env for local non-Compose runs. Never commit real secrets.
DATABASE_HOST=localhost
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=careerstack_backend_v2_development
QUEUE_DATABASE_NAME=careerstack_backend_v2_development_queue
DATABASE_PORT=55432
CORS_ORIGINS=http://localhost:5173
SECRET_KEY_BASE=replace-with-a-long-random-string
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Firebase Auth (staging project for local + staging). Stub tokens: test:<uid>:<email>
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_STUB=true
