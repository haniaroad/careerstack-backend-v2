# Copy to .env for local non-Compose runs. Never commit real secrets.
DATABASE_HOST=localhost
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=careerstack_backend_v2_development
QUEUE_DATABASE_NAME=careerstack_backend_v2_development_queue
DATABASE_PORT=55432
CORS_ORIGINS=http://localhost:5173
SECRET_KEY_BASE=replace-with-a-long-random-string
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Firebase Authentication (staging project is used for local and staging).
# Required whenever FIREBASE_AUTH_STUB is not enabled.
FIREBASE_PROJECT_ID=careerstack-staging

# When true, the API accepts stub tokens of the form
#   Authorization: Bearer test:<firebase_uid>:<email>
# instead of verifying real Firebase ID tokens. Defaults to true in test, and in
# development until FIREBASE_PROJECT_ID is set. Always ignored in production.
FIREBASE_AUTH_STUB=true

# Stripe (personal pack Checkout). Use test-mode keys locally and in staging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PERSONAL_PACK_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/return?status=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing/return?status=cancelled
