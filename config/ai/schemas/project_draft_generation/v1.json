{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "learning_objective",
    "project_type",
    "expected_duration",
    "project_end_date",
    "definition_of_done",
    "skills_demonstrated",
    "roles_needed",
    "proposed_tasks",
    "submission_expectations"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "learning_objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "project_type": { "type": "string", "minLength": 1, "maxLength": 120 },
    "expected_duration": { "type": "string", "minLength": 1, "maxLength": 120 },
    "project_end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "definition_of_done": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "skills_demonstrated": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 80 },
      "maxItems": 20
    },
    "roles_needed": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 80 },
      "maxItems": 10
    },
    "submission_expectations": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "proposed_tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "summary", "recommended_due_date", "submission_expectations"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "recommended_due_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "submission_expectations": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  }
}
